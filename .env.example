# MARS EXPLORER — Environment Variables
# NASA Space Apps Challenge 2026
#
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.
# NEVER hardcode these values in source code.
#
# All API integrations are OPTIONAL for the base application.
# The app runs fully without any API keys configured.

# ----------------------------------------------------------
# NASA APIs (optional — DEMO_KEY is used if not set)
# Request a free key at: https://api.nasa.gov/
# ----------------------------------------------------------

# NASA Open APIs key (rover photos, Mars weather, etc.)
# DEMO_KEY works for 30 requests/hour, 50/day without a key
VITE_NASA_API_KEY=DEMO_KEY

# ----------------------------------------------------------
# NASA Mars Rover Photos API
# https://api.nasa.gov/mars-photos/api/v1/rovers/
# ----------------------------------------------------------

# Base URL (default is used automatically)
# VITE_NASA_ROVER_API=https://api.nasa.gov/mars-photos/api/v1/rovers

# ----------------------------------------------------------
# NASA Trek WMTS (Mars map tiles)
# https://trek.nasa.gov/mars/
# ----------------------------------------------------------

# WMTS tile server URL for Martian map tiles
# VITE_MARS_TILE_SERVER=https://trek.nasa.gov/mars/TrekServices/ws/index/

# ----------------------------------------------------------
# Future: Supabase (cloud persistence — not currently needed)
# Only add when persistent user data or mission storage is required
# ----------------------------------------------------------

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------

# Application environment
VITE_APP_ENV=development

# Enable debug overlays and verbose logging
VITE_DEBUG=false
